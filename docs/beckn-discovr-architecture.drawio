        <!-- ACK label -->
        <mxCell id="ack-label" value="ACK (sync)" style="text;html=1;fontSize=10;fontStyle=2;fillColor=#E6F3FF;strokeColor=#4A90D9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="70" height="25" as="geometry" />
