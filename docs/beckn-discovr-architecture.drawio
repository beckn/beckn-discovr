              <mxPoint x="700" y="260" />
              <mxPoint x="700" y="460" />
              <mxPoint x="1180" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Query Engine -> Elasticsearch -->
        <mxCell id="e13" value="text search" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00BFB3;fontStyle=2;fontSize=10;dashed=1;" edge="1" parent="1" source="query-engine" target="elasticsearch">
          <mxGeometry relative="1" as="geometry">
