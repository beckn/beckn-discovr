        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid lines = data flow&lt;br&gt;Dashed lines = query&lt;br&gt;All communication via Kafka (async)" style="text;html=1;fontSize=10;align=left;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=1;" vertex="1" parent="1">
