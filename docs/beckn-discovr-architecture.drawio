<mxfile host="app.diagrams.net">
  <diagram name="Beckn Discovr Architecture" id="discovr-arch">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Beckn Discovr — Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- BAP -->
        <mxCell id="bap" value="BAP&lt;br&gt;(Beckn Application)" style="rounded=1;whiteSpace=wrap;fillColor=#4A90D9;fontColor=#ffffff;strokeColor=#3A7BC8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- BPP -->
        <mxCell id="bpp" value="BPP&lt;br&gt;(Beckn Provider)" style="rounded=1;whiteSpace=wrap;fillColor=#4A90D9;fontColor=#ffffff;strokeColor=#3A7BC8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Catalog Discover Job Group -->
        <mxCell id="discover-group" value="Catalog Discover Job :8082" style="swimlane;startSize=25;fillColor=#E6F3FF;strokeColor=#4A90D9;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="460" height="280" as="geometry" />
        </mxCell>

        <mxCell id="discover-api" value="POST /beckn/discover&lt;br&gt;&lt;i&gt;DiscoveryController&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;" vertex="1" parent="discover-group">
          <mxGeometry x="20" y="40" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="disc-consumer" value="DiscoveryEvent&lt;br&gt;Consumer" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;" vertex="1" parent="discover-group">
          <mxGeometry x="20" y="120" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="query-engine" value="Query Engine&lt;br&gt;&lt;i&gt;PostgreSQL + ES + NLWeb&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;" vertex="1" parent="discover-group">
          <mxGeometry x="250" y="120" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="pipeline" value="CatalogPipeline&lt;br&gt;&lt;i&gt;Filter → Dedup → Prune&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;" vertex="1" parent="discover-group">
          <mxGeometry x="250" y="185" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="response-proc" value="ResponseProcessor&lt;br&gt;&lt;i&gt;on_discover assembly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;" vertex="1" parent="discover-group">
          <mxGeometry x="20" y="210" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- Arrows inside discover group -->
        <mxCell id="e-dc1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="discover-group" source="disc-consumer" target="query-engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dc2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="discover-group" source="query-engine" target="pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dc3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="discover-group" source="pipeline" target="response-proc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Catalog Publish Job Group -->
        <mxCell id="publish-group" value="Catalog Publish Job :8085" style="swimlane;startSize=25;fillColor=#FFF3E0;strokeColor=#E8A838;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="460" height="200" as="geometry" />
        </mxCell>

        <mxCell id="push-api" value="POST /catalog/push&lt;br&gt;&lt;i&gt;CatalogPushController&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E8A838;fontSize=11;" vertex="1" parent="publish-group">
          <mxGeometry x="20" y="40" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="pub-consumer" value="CatalogPublish&lt;br&gt;Consumer&lt;br&gt;&lt;i&gt;Parse → Validate → Persist&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E8A838;fontSize=11;" vertex="1" parent="publish-group">
          <mxGeometry x="20" y="120" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Response Dispatcher Group -->
        <mxCell id="dispatcher-group" value="Response Dispatcher" style="swimlane;startSize=25;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="250" width="250" height="160" as="geometry" />
        </mxCell>

        <mxCell id="event-listener" value="EventListener&lt;br&gt;&lt;i&gt;Kafka Consumer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4CAF50;fontSize=11;" vertex="1" parent="dispatcher-group">
          <mxGeometry x="35" y="40" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="http-service" value="HttpService + SignatureService&lt;br&gt;&lt;i&gt;Beckn HTTP Signature&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4CAF50;fontSize=11;" vertex="1" parent="dispatcher-group">
          <mxGeometry x="35" y="100" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="e-disp" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="dispatcher-group" source="event-listener" target="http-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="Apache Kafka" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E8A838;fontColor=#ffffff;strokeColor=#D4942F;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="520" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="postgres" value="PostgreSQL&lt;br&gt;+ PostGIS" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#336791;fontColor=#ffffff;strokeColor=#2A5578;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="520" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Elasticsearch -->
        <mxCell id="elasticsearch" value="Elasticsearch" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#00BFB3;fontColor=#ffffff;strokeColor=#00A89E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="520" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- BAP -> Discover API -->
        <mxCell id="e1" value="discover" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4A90D9;fontStyle=2;fontSize=10;" edge="1" parent="1" source="bap" target="discover-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Discover API -> Kafka (request topic) -->
        <mxCell id="e2" value="request topic" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="discover-api" target="kafka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="205" />
              <mxPoint x="870" y="470" />
              <mxPoint x="980" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Kafka -> Discover Consumer -->
        <mxCell id="e3" value="consume" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="kafka" target="disc-consumer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="550" />
              <mxPoint x="900" y="280" />
              <mxPoint x="490" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Response Processor -> Kafka (response topic) -->
        <mxCell id="e4" value="response topic" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="response-proc" target="kafka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="400" />
              <mxPoint x="860" y="400" />
              <mxPoint x="860" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Kafka -> Response Dispatcher -->
        <mxCell id="e5" value="consume" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="kafka" target="event-listener">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="470" />
              <mxPoint x="980" y="303" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Dispatcher -> BAP callback -->
        <mxCell id="e6" value="POST on_discover&lt;br&gt;(signed)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4CAF50;fontStyle=2;fontSize=10;" edge="1" parent="1" source="http-service" target="bap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="395" />
              <mxPoint x="1250" y="100" />
              <mxPoint x="160" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- BPP -> Push API -->
        <mxCell id="e7" value="catalog/publish" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="bpp" target="push-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Push API -> Kafka -->
        <mxCell id="e8" value="publish topic" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="push-api" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kafka -> Publish Consumer -->
        <mxCell id="e9" value="consume" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E8A838;fontStyle=2;fontSize=10;" edge="1" parent="1" source="kafka" target="pub-consumer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="920" y="620" />
              <mxPoint x="490" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Publish Consumer -> PostgreSQL -->
        <mxCell id="e10" value="persist" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#336791;fontStyle=2;fontSize=10;" edge="1" parent="1" source="pub-consumer" target="postgres">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="650" />
              <mxPoint x="1180" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Publish Consumer -> Elasticsearch -->
        <mxCell id="e11" value="index" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00BFB3;fontStyle=2;fontSize=10;" edge="1" parent="1" source="pub-consumer" target="elasticsearch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="680" />
              <mxPoint x="1340" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Query Engine -> PostgreSQL -->
        <mxCell id="e12" value="spatial query" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#336791;fontStyle=2;fontSize=10;dashed=1;" edge="1" parent="1" source="query-engine" target="postgres">
          <mxGeometry relative="1" as="geometry">
