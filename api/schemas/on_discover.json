{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscoverResponse",
  "description": "Minimal schema for on_discover request body (DiscoverResponse shape)",
  "type": "object",
  "required": ["context", "message"],
  "properties": {
    "context": {
      "type": "object",
      "description": "Beckn context (transaction_id, etc.)",
      "required": [],
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "description": "Response message with optional catalogs",
      "properties": {
        "catalogs": {
          "type": "array",
          "description": "Array of catalogs",
          "items": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
