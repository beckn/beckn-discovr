{
  "name": "on-discovery-api",
  "version": "1.0.0",
  "description": "Lightweight POST /on_discover endpoint to receive discovery responses from catalog service and produce to Kafka",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "express": "^4.21.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@testcontainers/kafka": "^11.12.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^11.12.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
