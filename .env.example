# ── NP identity for np-signer (port 3031) ────────────────────────────────────
# Network Participant who hosts this Discovr instance. Signs subscription CRUD.
# DeDi registry record → base URL points to Discovr Ingestion (8085)
BAP_SUBSCRIBER_ID=beckn.bap.dev
BAP_RECORD_ID=<your-np-record-id>
BAP_PRIVATE_KEY=<your-np-ed25519-private-key-base64>

# ── Buyer identity for buyer-signer (port 3032) ─────────────────────────────
# Buyer (BAP) within the NP's network. Signs discover and pull requests.
# DeDi registry record → base URL points to Buyer Callbacks (8097)
BAP2_SUBSCRIBER_ID=beckn.bap.dev
BAP2_RECORD_ID=<your-buyer-record-id>
BAP2_PRIVATE_KEY=<your-buyer-ed25519-private-key-base64>

# ── Discovr pipeline outgoing signing (response-dispatcher) ─────────────────
# Signs on_discover callbacks sent to Buyers
SIGNING_SUBSCRIBER_ID=beckn.discover.dev
SIGNING_KEY_ID_SUFFIX=<your-signing-record-id>
SIGNING_PRIVATE_KEY=<your-signing-ed25519-private-key-base64>
