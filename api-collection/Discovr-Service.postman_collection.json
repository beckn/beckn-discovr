						"body": {
							"mode": "raw",
							"raw": "{\n    \"context\": {\n        \"version\": \"2.0.0\",\n        \"action\": \"catalog/push\",\n        \"timestamp\": \"2026-04-28T10:30:05Z\",\n        \"transactionId\": \"fe3b216a-bca7-48d9-a4dd-78e9de9c984d\",\n        \"messageId\": \"6636da5a-4845-4a93-b080-3b4a83662501\",\n        \"networkId\": \"beckn.one/retail\",\n        \"subscriberId\": \"catalg.beckn.org\"\n    },\n    \"message\": {\n        \"publishDirectives\": [\n            {\n                \"catalogId\": \"CAT-GROCERY-FRESHMART-005\",\n                \"catalogType\": \"regular\",\n                \"updateMode\": \"MERGE\"\n            }\n        ],\n        \"catalogs\": [\n            {\n                \"id\": \"CAT-GROCERY-FRESHMART-005\",\n                \"descriptor\": {\n                    \"name\": \"FreshMart Grocery Catalog\",\n                    \"shortDesc\": \"Daily essentials \\u2014 tea, coffee & beverages\"\n                },\n                \"provider\": {\n                    \"id\": \"PROV-FRESHMART-05\",\n                    \"descriptor\": {\n                        \"name\": \"FreshMart Pvt Ltd\"\n                    },\n                    \"availableAt\": [\n                        {\n                            \"geo\": {\n                                \"type\": \"Point\",\n                                \"coordinates\": [77.6401, 12.9116]\n                            },\n                            \"address\": {\n                                \"streetAddress\": \"27th Main Rd, Sector 2, HSR Layout\",\n                                \"addressLocality\": \"Bengaluru\",\n                                \"addressRegion\": \"Karnataka\",\n                                \"postalCode\": \"560102\",\n                                \"addressCountry\": \"IN\"\n                            }\n                        }\n                    ]\n                },\n                \"resources\": [\n                    {\n                        \"id\": \"RES-GROCERY-BRU-GOLD-INSTANT-COFFEE-200GRAMS\",\n                        \"descriptor\": {\n                            \"name\": \"Bru Gold Instant Coffee Powder\",\n                            \"shortDesc\": \"Rich and aromatic instant coffee powder, 200g\"\n                        },\n                        \"resourceAttributes\": {\n                            \"@context\": \"https://schema.beckn.io/GroceryResource/v2.1/context.jsonld\",\n                            \"@type\": \"GroceryResource\",\n                            \"identity\": {\n                                \"brand\": \"Bru\",\n                                \"originCountry\": \"IN\"\n                            },\n                            \"physical\": {\n                                \"weight\": {\n                                    \"unitCode\": \"G\",\n                                    \"unitQuantity\": 200\n                                }\n                            },\n                            \"food\": {\n                                \"classification\": \"VEG\"\n                            }\n                        }\n                    }\n                ]\n            }\n        ]\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
