					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.variables.set('sign-host', 'http://localhost:3030');",
							"",
							"console.log('=== Starting signing process ===');",
							"",
							"const resolveVariables = (str) => {",
							"    return str.replace(/\\{\\{([^}]+)\\}\\}/g, (match, varName) => {",
							"        const value = pm.variables.get(varName);",
							"        return value !== undefined ? value : match;",
							"    });",
							"};",
							"",
							"let requestBody = '';",
							"if (pm.request.body && pm.request.body.raw) {",
							"    requestBody = pm.request.body.raw;",
							"    requestBody = resolveVariables(requestBody);",
							"}",
							"",
							"// Sign even when no body (GET/DELETE) \u2014 use empty string for digest",
							"if (!requestBody) {",
							"    requestBody = '';",
							"    console.log('No request body \u2014 signing empty string for GET/DELETE');",
							"}",
							"",
							"console.log('Body to sign:', requestBody);",
							"",
							"const signPayload = () => {",
							"    return new Promise((resolve, reject) => {",
							"        pm.sendRequest({",
							"            url: pm.variables.get('sign-host') + '/sign-payload',",
							"            method: 'POST',",
							"            header: { 'Content-Type': 'application/json' },",
							"            body: { mode: 'raw', raw: requestBody }",
							"        }, function (err, response) {",
							"            if (err) { console.error('Error calling signing endpoint:', err); reject(err); return; }",
							"            console.log('Signing response status:', response.code);",
							"            resolve(response.text());",
							"        });",
							"    });",
							"};",
							"",
							"(async () => {",
							"    try {",
							"        const signature = await signPayload();",
							"        pm.request.headers.upsert({ key: 'Authorization', value: signature });",
							"        console.log('=== Authorization header set successfully ===');",
							"    } catch (error) {",
							"        console.error('Failed to sign payload:', error);",
							"    }",
							"})();"
						]
					}
				}
			]
		},
